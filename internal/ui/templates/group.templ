package templates

import (
	"strconv"

	"github.com/contiamo/fettle/internal/schema"
)

// GroupDetail renders one group from a group run, including its
// resolved member findings (linked back to their detail pages on the
// input run) and any ids that didn't resolve.
templ GroupDetail(v GroupView) {
	@Page(v.Group.Title, groupBreadcrumbs(v.Manifest.Name)) {
		<article class="space-y-7 max-w-4xl">
			<header class="space-y-3">
				<h1 class="font-serif text-[28px] leading-tight tracking-tight text-foreground">{ v.Group.Title }</h1>
				<div class="flex items-baseline gap-3 text-[12.5px] text-muted-foreground">
					<span class="tabular-nums">
						{ strconv.Itoa(len(v.Group.FindingIDs)) }
						if len(v.Group.FindingIDs) == 1 {
							{ " finding" }
						} else {
							{ " findings" }
						}
					</span>
					<span class="text-border" aria-hidden="true">·</span>
					<a href={ templ.SafeURL("/runs/" + v.Manifest.Name) } class="hover:text-foreground transition-colors">{ v.Manifest.Name }</a>
				</div>
				<div class="flex items-baseline gap-3 text-[11px] text-muted-foreground flex-wrap">
					<span><span class="text-muted-foreground/70">id</span> <span class="ml-1">@DataCode(DataCodeID, v.Group.ID)</span></span>
					if v.Group.CreatedBy != "" {
						<span class="text-border" aria-hidden="true">·</span>
						<span><span class="text-muted-foreground/70">by</span> <span class="ml-1">@AuthorStamp(v.Group.CreatedBy)</span></span>
						<span class="text-border" aria-hidden="true">·</span>
						<span class="tabular-nums">{ v.Group.CreatedAt.Format("2006-01-02 15:04 MST") }</span>
					}
					if v.Manifest.InputRun != "" {
						<span class="text-border" aria-hidden="true">·</span>
						<span><span class="text-muted-foreground/70">input run</span> <span class="ml-1">@DataCode(DataCodeID, v.Manifest.InputRun)</span></span>
					}
				</div>
				if len(v.Group.Labels) > 0 {
					<div class="pt-1">
						@LabelChips(v.Group.Labels)
					</div>
				}
			</header>
			if v.Group.Summary != "" {
				@findingSection("Summary", v.Group.Summary)
			}
			@groupMembersSection(v)
			@ReviewSection(v.Review)
			@OutcomeSection(v.Outcome)
		</article>
	}
}

templ groupMembersSection(v GroupView) {
	<section class="space-y-2.5">
		@SectionHeading("Members")
		if len(v.Members) == 0 && len(v.MissingIDs) == 0 {
			<div class="text-sm text-muted-foreground italic">This group has no members.</div>
		} else {
			<div class="rounded-lg border border-border bg-card overflow-hidden">
				<table class="w-full text-sm">
					<thead class="text-muted-foreground text-left text-[10px] uppercase tracking-[0.08em] font-medium border-b border-border">
						<tr>
							<th class="px-4 py-2.5 font-medium">Location</th>
							<th class="px-4 py-2.5 font-medium">Title</th>
							<th class="px-4 py-2.5 font-medium">Severity</th>
							<th class="px-4 py-2.5 font-medium">Labels</th>
						</tr>
					</thead>
					<tbody class="divide-y divide-border">
						for _, f := range v.Members {
							@groupMemberRow(v.InputRunName, f)
						}
						for _, id := range v.MissingIDs {
							@missingMemberRow(id)
						}
					</tbody>
				</table>
			</div>
		}
		if len(v.MissingIDs) > 0 {
			if v.InputRunName == "" {
				<p class="text-xs text-muted-foreground italic">
					This group's manifest doesn't reference a valid input run under <code class="font-mono">runs/</code>; member findings can't be resolved.
				</p>
			} else {
				<p class="text-xs text-muted-foreground italic">
					{ strconv.Itoa(len(v.MissingIDs)) } member finding(s) couldn't be resolved in the input run; they may have been deleted or the input run was removed.
				</p>
			}
		}
	</section>
}

templ groupMemberRow(inputRunName string, f schema.Finding) {
	{{ href := "/runs/" + inputRunName + "?focus=" + f.ID }}
	<tr class="hover:bg-accent/40 transition-colors cursor-pointer align-top group" data-row-link={ href }>
		<td class="px-4 py-3 font-mono text-xs whitespace-nowrap">
			<span class="text-foreground">{ f.File }</span>
			<span class="text-muted-foreground">:{ strconv.Itoa(f.Line) }</span>
		</td>
		<td class="px-4 py-3">
			<a href={ templ.SafeURL(href) } class="text-foreground group-hover:text-primary">{ f.Title }</a>
		</td>
		<td class="px-4 py-3 whitespace-nowrap">
			@SeverityPill(f.Severity)
		</td>
		<td class="px-4 py-3">
			@LabelChips(f.Labels)
		</td>
	</tr>
}

templ missingMemberRow(id string) {
	<tr class="align-top">
		<td class="px-4 py-3 font-mono text-xs text-muted-foreground" colspan="4">
			<span class="text-muted-foreground italic">missing finding</span>
			<code class="ml-2">{ id }</code>
		</td>
	</tr>
}

func groupBreadcrumbs(runName string) []BreadcrumbItem {
	return []BreadcrumbItem{
		{Title: "Runs", Href: "/"},
		{Title: runName, Href: "/runs/" + runName},
		{Title: "Group"},
	}
}
