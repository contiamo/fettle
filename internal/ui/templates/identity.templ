package templates

import (
	"github.com/contiamo/fettle/internal/ui/components/button"
	"github.com/contiamo/fettle/internal/ui/components/form"
	"github.com/contiamo/fettle/internal/ui/components/input"
)

// IdentityView is the data passed to the Identity prompt template.
// CurrentSlug is non-empty when an identity is already saved (the
// page is reachable from a "change identity" link as well as the
// first-edit redirect). Error renders inline under the input when
// validation or persistence failed on a previous submit.
type IdentityView struct {
	Next        string
	Prefill     string
	CurrentSlug string
	Error       string
}

// Identity is the slug-prompt page. The form posts to /identity; on
// success the server redirects to ?next= (defaulting to /).
templ Identity(v IdentityView) {
	@Page("Reviewer identity", []BreadcrumbItem{{Title: "Identity"}}) {
		<section class="max-w-md mx-auto space-y-6">
			<header class="space-y-1">
				<h1 class="text-2xl font-semibold tracking-tight">Pick your reviewer slug</h1>
				<p class="text-sm text-muted-foreground">
					Fettle stamps every label, comment, and outcome with the slug below
					and stores it in <code class="font-mono text-foreground">~/.config/fettle/identity</code>
					— per-user, per-machine, never written to the project.
				</p>
			</header>
			<form method="POST" action="/identity" class="space-y-4">
				<input type="hidden" name="next" value={ v.Next }/>
				@form.Item() {
					@form.Label(form.LabelProps{For: "slug"}) {
						Slug
					}
					@input.Input(input.Props{
						ID:          "slug",
						Name:        "slug",
						Type:        input.TypeText,
						Value:       v.Prefill,
						Placeholder: "alice",
						Required:    true,
						HasError:    v.Error != "",
						Class:       "font-mono",
						Attributes: templ.Attributes{
							"pattern":      "[A-Za-z0-9_\\-]+",
							"autocomplete": "off",
							"autofocus":    true,
						},
					})
					@form.Description() {
						Letters, digits, hyphens, underscores. Becomes part of
						@DataCode(DataCodeID, "reviews_<slug>.jsonl")
						.
					}
					if v.Error != "" {
						@form.Message(form.MessageProps{Variant: form.MessageVariantError}) {
							{ v.Error }
						}
					}
				}
				<div class="flex items-center justify-between">
					@button.Button(button.Props{Type: button.TypeSubmit}) {
						Save and continue
					}
					if v.CurrentSlug != "" {
						<span class="text-xs text-muted-foreground flex items-baseline gap-1.5">
							Currently:
							@AuthorStamp(v.CurrentSlug)
						</span>
					}
				</div>
			</form>
		</section>
	}
}
