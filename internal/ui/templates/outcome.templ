package templates

import (
	"github.com/contiamo/fettle/internal/schema"
	"github.com/contiamo/fettle/internal/ui/components/button"
	"github.com/contiamo/fettle/internal/ui/components/form"
	"github.com/contiamo/fettle/internal/ui/components/input"
)

// OutcomeSection renders the outcome form (status + optional pr_url)
// and the chronological history of outcome events. Latest event is
// the current state; earlier ones are kept visible to make audit
// trivial.
templ OutcomeSection(v OutcomeSectionView) {
	<section id="outcome-section" class="space-y-3 border-t border-border pt-6">
		<header class="flex items-baseline justify-between gap-3">
			@SectionHeading("Outcome")
			if v.Latest != nil {
				<span class="text-[11px] flex items-baseline gap-2">
					<span class="text-muted-foreground">currently</span>
					@DataCode(DataCodeStatus, v.Latest.Status)
					<span class="text-muted-foreground">· marked by</span>
					@AuthorStamp(v.Latest.Author)
				</span>
			}
		</header>
		if ReviewerFromContext(ctx) == nil {
			@identityRequired("record an outcome")
		} else {
			<form
				hx-post={ v.PostURL() }
				hx-target="#outcome-section"
				hx-swap="outerHTML"
				class="space-y-3 rounded-md border border-border bg-card p-3.5"
			>
				<div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
					@form.Item(form.ItemProps{Class: "sm:col-span-1"}) {
						@form.Label(form.LabelProps{For: "outcome-status"}) {
							Status
						}
						<select
							id="outcome-status"
							name="status"
							required
							class="w-full rounded-md border border-input bg-background px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-ring/40 focus:border-ring"
						>
							<option value="">— pick —</option>
							<option value="merged">merged</option>
							<option value="closed">closed</option>
							<option value="wontfix">wontfix</option>
							<option value="other">other</option>
						</select>
					}
					@form.Item(form.ItemProps{Class: "sm:col-span-2"}) {
						@form.Label(form.LabelProps{For: "outcome-status-other"}) {
							Status (if other)
						}
						@input.Input(input.Props{
							ID:          "outcome-status-other",
							Name:        "status_other",
							Type:        input.TypeText,
							Placeholder: "free-form, used only when status = other",
							Class:       "font-mono",
							Attributes:  templ.Attributes{"autocomplete": "off"},
						})
					}
				</div>
				@form.Item() {
					@form.Label(form.LabelProps{For: "outcome-pr"}) {
						PR / commit URL (optional)
					}
					@input.Input(input.Props{
						ID:          "outcome-pr",
						Name:        "pr_url",
						Type:        input.TypeURL,
						Placeholder: "https://…",
						Class:       "font-mono",
						Attributes:  templ.Attributes{"autocomplete": "off"},
					})
				}
				if v.Error != "" {
					@form.Message(form.MessageProps{Variant: form.MessageVariantError}) {
						{ v.Error }
					}
				}
				<div class="flex justify-end">
					@button.Button(button.Props{Type: button.TypeSubmit, Size: button.SizeSm}) {
						Record outcome
					}
				</div>
			</form>
		}
		if len(v.History) > 0 {
			<ol class="space-y-2 text-sm">
				for i, o := range v.History {
					@outcomeEntry(o, i == len(v.History)-1)
				}
			</ol>
		} else {
			@EmptyHint("No outcome events yet.")
		}
	</section>
}

templ outcomeEntry(o schema.Outcome, isLatest bool) {
	<li class="rounded-md border border-border bg-surface-sunken p-3 space-y-1.5">
		<div class="flex items-baseline justify-between gap-3 text-xs">
			<div class="flex items-baseline gap-2">
				@DataCode(DataCodeStatus, o.Status)
				if isLatest {
					@StatusPill(StatusToneInfo, "latest")
				}
				<span class="text-muted-foreground">·</span>
				@AuthorStamp(o.Author)
			</div>
			<span class="text-muted-foreground tabular-nums">{ o.At.Format("2006-01-02 15:04 MST") }</span>
		</div>
		if o.PRURL != "" {
			<a href={ templ.SafeURL(o.PRURL) } class="text-xs font-mono text-primary hover:underline break-all">{ o.PRURL }</a>
		}
	</li>
}
