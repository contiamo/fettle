package templates

import "github.com/contiamo/fettle/internal/schema"

// OutcomeSection renders the outcome form (status + optional pr_url)
// and the chronological history of outcome events. Latest event is
// the current state; earlier ones are kept visible to make audit
// trivial.
templ OutcomeSection(v OutcomeSectionView) {
	<section id="outcome-section" class="space-y-3 border-t border-border pt-6">
		<header class="flex items-baseline justify-between gap-3">
			<h2 class="text-[10px] font-medium tracking-[0.1em] uppercase text-muted-foreground">Outcome</h2>
			if v.Latest != nil {
				<span class="text-[11px]">
					<span class="text-muted-foreground">currently </span>
					<code class="font-mono text-foreground">{ v.Latest.Status }</code>
					<span class="text-muted-foreground"> · marked by </span>
					<code class="font-mono text-foreground">{ v.Latest.Author }</code>
				</span>
			}
		</header>
		if ReviewerFromContext(ctx) == nil {
			@identityRequired("record an outcome")
		} else {
			<form
				hx-post={ v.PostURL() }
				hx-target="#outcome-section"
				hx-swap="outerHTML"
				class="space-y-3 rounded-md border border-border bg-card p-3.5"
			>
				<div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
					<div class="space-y-1.5 sm:col-span-1">
						<label for="outcome-status" class="text-[11px] font-medium text-foreground">Status</label>
						<select
							id="outcome-status"
							name="status"
							required
							class="w-full rounded-md border border-border bg-background px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-ring/40 focus:border-ring"
						>
							<option value="">— pick —</option>
							<option value="merged">merged</option>
							<option value="closed">closed</option>
							<option value="wontfix">wontfix</option>
							<option value="other">other</option>
						</select>
					</div>
					<div class="space-y-1.5 sm:col-span-2">
						<label for="outcome-status-other" class="text-[11px] font-medium text-foreground">Status (if other)</label>
						<input
							id="outcome-status-other"
							name="status_other"
							type="text"
							placeholder="free-form, used only when status = other"
							class="w-full rounded-md border border-border bg-background px-3 py-2 text-sm font-mono focus:outline-none focus:ring-2 focus:ring-ring/40 focus:border-ring"
							autocomplete="off"
						/>
					</div>
				</div>
				<div class="space-y-1.5">
					<label for="outcome-pr" class="text-[11px] font-medium text-foreground">PR / commit URL (optional)</label>
					<input
						id="outcome-pr"
						name="pr_url"
						type="url"
						placeholder="https://…"
						class="w-full rounded-md border border-border bg-background px-3 py-2 text-sm font-mono focus:outline-none focus:ring-2 focus:ring-ring/40 focus:border-ring"
						autocomplete="off"
					/>
				</div>
				if v.Error != "" {
					<p class="text-xs text-destructive">{ v.Error }</p>
				}
				<div class="flex justify-end">
					<button
						type="submit"
						class="inline-flex items-center justify-center rounded-md bg-foreground text-background px-3 py-1.5 text-xs font-medium hover:bg-foreground/90 transition-colors cursor-pointer"
					>
						Record outcome
					</button>
				</div>
			</form>
		}
		if len(v.History) > 0 {
			<ol class="space-y-2 text-sm">
				for i, o := range v.History {
					@outcomeEntry(o, i == len(v.History)-1)
				}
			</ol>
		} else {
			<p class="text-[11px] text-muted-foreground italic">No outcome events yet.</p>
		}
	</section>
}

templ outcomeEntry(o schema.Outcome, isLatest bool) {
	<li class="rounded-md border border-border bg-surface-sunken p-3 space-y-1.5">
		<div class="flex items-baseline justify-between gap-3 text-xs">
			<div class="flex items-baseline gap-2">
				<code class="font-mono text-foreground">{ o.Status }</code>
				if isLatest {
					<span class="text-[10px] uppercase tracking-[0.06em] text-primary">latest</span>
				}
				<span class="text-muted-foreground">·</span>
				<code class="font-mono text-muted-foreground">{ o.Author }</code>
			</div>
			<span class="text-muted-foreground tabular-nums">{ o.At.Format("2006-01-02 15:04 MST") }</span>
		</div>
		if o.PRURL != "" {
			<a href={ templ.SafeURL(o.PRURL) } class="text-xs font-mono text-primary hover:underline break-all">{ o.PRURL }</a>
		}
	</li>
}
