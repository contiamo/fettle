package templates

import (
	"context"
	"strings"

	"github.com/contiamo/fettle/internal/ui/components/button"
	"github.com/contiamo/fettle/internal/ui/components/form"
	"github.com/contiamo/fettle/internal/ui/components/icon"
	"github.com/contiamo/fettle/internal/ui/components/input"
	"github.com/contiamo/fettle/internal/ui/components/selectbox"
	"github.com/contiamo/fettle/internal/ui/components/textarea"
)

// ReviewSection renders the label/comment form alongside the per-author
// review feed. Same template is used on initial GET and on HTMX swap
// after a POST — the form's hx-target points at #review-section so
// the server can return just this block.
templ ReviewSection(v ReviewSectionView) {
	<section id="review-section" class="space-y-3 border-t border-border pt-6">
		<header class="flex items-baseline justify-between gap-3">
			@SectionHeading("Review")
		</header>
		if ReviewerFromContext(ctx) == nil {
			@identityRequired("leave a review")
		} else {
			<form
				hx-post={ v.PostURL() }
				hx-target="#review-section"
				hx-swap="outerHTML"
				class="space-y-3 rounded-md border border-border bg-card p-3.5"
			>
				@editableLabels("review-labels", strings.Join(v.InitialLabels, ", "))
				@editableSeverity("review-severity", myLatestSeverityValue(ctx, v.Entries))
				@form.Item() {
					@form.Label(form.LabelProps{For: "review-comment"}) {
						Comment
					}
					@textarea.Textarea(textarea.Props{
						ID:          "review-comment",
						Name:        "comment",
						Rows:        3,
						Placeholder: "Optional",
					})
				}
				if v.Error != "" {
					@form.Message(form.MessageProps{Variant: form.MessageVariantError}) {
						{ v.Error }
					}
				}
				<div class="flex justify-end">
					@button.Button(button.Props{Type: button.TypeSubmit, Size: button.SizeSm}) {
						Save review
					}
				</div>
			</form>
		}
		if len(v.Entries) > 0 {
			<ol class="space-y-2 text-sm">
				for _, e := range v.Entries {
					@reviewEntry(e)
				}
			</ol>
		} else {
			@EmptyHint("No reviews yet.")
		}
	</section>
}

// myLatestSeverityValue returns the current reviewer's most recent
// severity choice on this subject so the form's select pre-selects
// the right option when the editor is opened. Returns "" (no choice)
// when there's no identity, no prior review by this user, or the
// prior review left severity unset.
func myLatestSeverityValue(ctx context.Context, entries []ReviewEntryView) string {
	r := ReviewerFromContext(ctx)
	if r == nil {
		return ""
	}
	for _, e := range entries {
		if e.IsLatest && e.Author == r.String() && e.Severity != nil {
			return *e.Severity
		}
	}
	return ""
}

// editableLabels is a "no change" preview with a pencil-edit
// affordance: the input stays disabled (and so absent from form
// submission) until the reviewer clicks the edit icon. Empty input
// while editing means "explicit clear" because we know editing was
// engaged; nil-don't-touch is reserved for the case where the
// reviewer never opened the editor at all.
//
// initial is the reviewer's latest label set, joined with ", ", so
// engaging the editor pre-fills with what they last had — same
// "edit, don't retype" friendliness the prior form had, just gated
// behind an explicit gesture.
templ editableLabels(id, initial string) {
	@form.Item(form.ItemProps{Class: "space-y-1.5", Attributes: templ.Attributes{"data-edit-field": "labels"}}) {
		@form.Label(form.LabelProps{For: id}) {
			Labels
		}
		<div class="flex items-center gap-2" data-edit-preview="labels">
			<span class="text-[12.5px] text-muted-foreground italic">no change</span>
			@editToggleButton("labels", "Edit labels")
		</div>
		<div class="flex items-center gap-2" data-edit-editor="labels" hidden>
			@input.Input(input.Props{
				ID:          id,
				Name:        "labels",
				Type:        input.TypeText,
				Placeholder: "comma- or space-separated, e.g. ack, fp",
				Value:       initial,
				Class:       "font-mono",
				Disabled:    true,
				Attributes:  templ.Attributes{"autocomplete": "off"},
			})
			@editRevertButton("labels", "Cancel labels edit")
		</div>
	}
}

// editableSeverity is the severity twin of editableLabels. Same
// disabled-until-clicked pattern: not engaging the editor submits
// no severity field at all (server reads that as nil = "didn't
// touch"). The editor uses the templui selectbox component (its
// search affordance is hidden via NoSearch since the option set is
// fixed three values), so the dropdown reads consistently with the
// rest of the templui surface instead of falling back to the
// browser's default <select> chrome.
//
// "Defer to LLM" no longer appears as an option — engaging the
// editor implies the reviewer is choosing a severity, and the not-
// engaged path already covers "leave it alone".
templ editableSeverity(id, current string) {
	@form.Item(form.ItemProps{Class: "space-y-1.5", Attributes: templ.Attributes{"data-edit-field": "severity"}}) {
		@form.Label(form.LabelProps{For: id}) {
			Severity
		}
		<div class="flex items-center gap-2" data-edit-preview="severity">
			<span class="text-[12.5px] text-muted-foreground italic">no change</span>
			@editToggleButton("severity", "Edit severity")
		</div>
		<div class="flex items-center gap-2" data-edit-editor="severity" hidden>
			<div class="flex-1">
				@selectbox.SelectBox() {
					@selectbox.Trigger(selectbox.TriggerProps{
						ID:       id,
						Name:     "severity",
						Disabled: true,
					}) {
						@richSelectDisplay("Pick severity")
					}
					@selectbox.Content(selectbox.ContentProps{NoSearch: true}) {
						@selectbox.Item(selectbox.ItemProps{Value: "high", Selected: current == "high"}) {
							@SeverityPill(severityRef("high"))
						}
						@selectbox.Item(selectbox.ItemProps{Value: "medium", Selected: current == "medium"}) {
							@SeverityPill(severityRef("medium"))
						}
						@selectbox.Item(selectbox.ItemProps{Value: "low", Selected: current == "low"}) {
							@SeverityPill(severityRef("low"))
						}
					}
				}
			</div>
			@editRevertButton("severity", "Cancel severity edit")
		</div>
	}
}

// editToggleButton is the small pencil button that flips a field
// from "no change" preview to its real input. data-edit-show
// identifies which field the JS should reveal.
templ editToggleButton(field, title string) {
	<button
		type="button"
		data-edit-show={ field }
		title={ title }
		aria-label={ title }
		class="inline-flex items-center justify-center w-6 h-6 rounded text-muted-foreground hover:text-foreground hover:bg-accent/60 transition-colors cursor-pointer shrink-0"
	>
		@icon.Pencil(icon.Props{Class: "w-3.5 h-3.5"})
	</button>
}

// editRevertButton lives next to the active editor and lets the
// reviewer back out without touching the field. It re-disables the
// underlying input so submitting now sends nothing for that field
// (interpreted server-side as "didn't touch").
templ editRevertButton(field, title string) {
	<button
		type="button"
		data-edit-revert={ field }
		title={ title }
		aria-label={ title }
		class="inline-flex items-center justify-center w-6 h-6 rounded text-muted-foreground hover:text-foreground hover:bg-accent/60 transition-colors cursor-pointer shrink-0"
	>
		@icon.X(icon.Props{Class: "w-3.5 h-3.5"})
	</button>
}

// identityRequired stands in for review/outcome forms when the current
// session has no reviewer identity configured. Submitting either
// without an identity bounces through /identity anyway and re-types
// the form on return — better UX is to show up-front that the action
// is gated, with a one-click path to set up. action is the verb-
// phrase the placeholder reads ("leave a review", "record an
// outcome") so the same component covers both call-sites.
templ identityRequired(action string) {
	<div class="rounded-md border border-dashed border-border bg-card px-4 py-5 text-center space-y-2.5">
		<p class="text-[12.5px] text-muted-foreground">Set your reviewer identity to { action }.</p>
		@button.Button(button.Props{Href: identityChangeHref(ctx), Size: button.SizeSm}) {
			Set identity
		}
	</div>
}

templ reviewEntry(e ReviewEntryView) {
	<li class="rounded-md border border-border bg-surface-sunken p-3 space-y-1.5">
		<div class="flex items-baseline justify-between gap-3 text-xs">
			<div class="flex items-baseline gap-2">
				@AuthorStamp(e.Author)
				if e.IsLatest {
					@StatusPill(StatusToneInfo, "latest")
				}
				if e.Severity != nil {
					<span class="text-muted-foreground">set severity to</span>
					@SeverityPill(e.Severity)
				}
			</div>
			<span class="text-muted-foreground tabular-nums">{ e.At.Format("2006-01-02 15:04 MST") }</span>
		</div>
		if len(e.Add) > 0 {
			<div class="flex items-baseline gap-2 flex-wrap text-xs">
				<span class="text-muted-foreground shrink-0">added</span>
				@LabelChips(e.Add)
			</div>
		}
		if len(e.Remove) > 0 {
			<div class="flex items-baseline gap-2 flex-wrap text-xs">
				<span class="text-muted-foreground shrink-0">removed</span>
				@LabelChips(e.Remove)
			</div>
		}
		if strings.TrimSpace(e.Comment) != "" {
			<p class="text-[13.5px] text-foreground whitespace-pre-wrap leading-relaxed">
				@RichText(e.Comment)
			</p>
		}
	</li>
}
