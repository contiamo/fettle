package templates

import (
	"strings"
)

// ReviewSection renders the label/comment form alongside the per-author
// review feed. Same template is used on initial GET and on HTMX swap
// after a POST — the form's hx-target points at #review-section so
// the server can return just this block.
templ ReviewSection(v ReviewSectionView) {
	<section id="review-section" class="space-y-3 border-t border-border pt-6">
		<header class="flex items-baseline justify-between gap-3">
			<h2 class="text-[10px] font-medium tracking-[0.1em] uppercase text-muted-foreground">Review</h2>
			if len(v.CurrentLabels) > 0 {
				<div class="flex items-center gap-2 flex-wrap">
					<span class="text-[11px] text-muted-foreground">current labels</span>
					@labelChips(v.CurrentLabels)
				</div>
			}
		</header>
		<form
			hx-post={ v.PostURL() }
			hx-target="#review-section"
			hx-swap="outerHTML"
			class="space-y-3 rounded-md border border-border bg-card p-3.5"
		>
			<div class="space-y-1.5">
				<label for="review-labels" class="text-[11px] font-medium text-foreground">Labels</label>
				<input
					id="review-labels"
					name="labels"
					type="text"
					placeholder="comma- or space-separated, e.g. ack, fp, severity:high"
					class="w-full rounded-md border border-border bg-background px-3 py-2 text-sm font-mono focus:outline-none focus:ring-2 focus:ring-ring/40 focus:border-ring"
					autocomplete="off"
				/>
				<p class="text-[11px] text-muted-foreground">
					Replaces your previous label set on this { v.SubjectKind }.
					Submit with no labels to clear yours.
				</p>
			</div>
			<div class="space-y-1.5">
				<label for="review-comment" class="text-[11px] font-medium text-foreground">Comment</label>
				<textarea
					id="review-comment"
					name="comment"
					rows="3"
					placeholder="Optional"
					class="w-full rounded-md border border-border bg-background px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-ring/40 focus:border-ring resize-y"
				></textarea>
			</div>
			if v.Error != "" {
				<p class="text-xs text-destructive">{ v.Error }</p>
			}
			<div class="flex justify-end">
				<button
					type="submit"
					class="inline-flex items-center justify-center rounded-md bg-foreground text-background px-3 py-1.5 text-xs font-medium hover:bg-foreground/90 transition-colors cursor-pointer"
				>
					Save review
				</button>
			</div>
		</form>
		if len(v.Entries) > 0 {
			<ol class="space-y-2 text-sm">
				for _, e := range v.Entries {
					@reviewEntry(e)
				}
			</ol>
		} else {
			<p class="text-[11px] text-muted-foreground italic">No reviews yet.</p>
		}
	</section>
}

templ reviewEntry(e ReviewEntryView) {
	<li class="rounded-md border border-border bg-surface-sunken p-3 space-y-1.5">
		<div class="flex items-baseline justify-between gap-3 text-xs">
			<div class="flex items-baseline gap-2">
				<code class="font-mono text-foreground">{ e.Author }</code>
				if e.IsLatest {
					<span class="text-[10px] uppercase tracking-[0.06em] text-primary">latest</span>
				}
			</div>
			<span class="text-muted-foreground tabular-nums">{ e.At.Format("2006-01-02 15:04 MST") }</span>
		</div>
		if len(e.Labels) > 0 {
			@labelChips(e.Labels)
		} else {
			<span class="text-[11px] text-muted-foreground italic">no labels</span>
		}
		if strings.TrimSpace(e.Comment) != "" {
			<p class="text-[13.5px] text-foreground whitespace-pre-wrap leading-relaxed">{ e.Comment }</p>
		}
	</li>
}
