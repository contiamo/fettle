package templates

import (
	"context"
	"strings"

	"github.com/contiamo/fettle/internal/ui/components/button"
)

// ReviewSection renders the label/comment form alongside the per-author
// review feed. Same template is used on initial GET and on HTMX swap
// after a POST — the form's hx-target points at #review-section so
// the server can return just this block.
templ ReviewSection(v ReviewSectionView) {
	<section id="review-section" class="space-y-3 border-t border-border pt-6">
		<header class="flex items-baseline justify-between gap-3">
			@SectionHeading("Review")
		</header>
		if len(v.CurrentLabels) > 0 {
			<div class="space-y-1.5">
				<span class="text-[11px] text-muted-foreground">current labels</span>
				@LabelChips(v.CurrentLabels)
			</div>
		}
		if ReviewerFromContext(ctx) == nil {
			@identityRequired("leave a review")
		} else {
			<form
				hx-post={ v.PostURL() }
				hx-target="#review-section"
				hx-swap="outerHTML"
				class="space-y-3 rounded-md border border-border bg-card p-3.5"
			>
				<div class="space-y-1.5">
					<label for="review-labels" class="text-[11px] font-medium text-foreground">Labels</label>
					<input
						id="review-labels"
						name="labels"
						type="text"
						placeholder="comma- or space-separated, e.g. ack, fp, severity:high"
						value={ strings.Join(myLatestLabels(ctx, v.Entries), ", ") }
						class="w-full rounded-md border border-border bg-background px-3 py-2 text-sm font-mono focus:outline-none focus:ring-2 focus:ring-ring/40 focus:border-ring"
						autocomplete="off"
					/>
					<p class="text-[11px] text-muted-foreground">
						Your current label set on this { v.SubjectKind }; submitting saves whatever's in the box (clear it to remove all of yours).
					</p>
				</div>
				<div class="space-y-1.5">
					<label for="review-comment" class="text-[11px] font-medium text-foreground">Comment</label>
					<textarea
						id="review-comment"
						name="comment"
						rows="3"
						placeholder="Optional"
						class="w-full rounded-md border border-border bg-background px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-ring/40 focus:border-ring resize-y"
					></textarea>
				</div>
				if v.Error != "" {
					<p class="text-xs text-destructive">{ v.Error }</p>
				}
				<div class="flex justify-end">
					@button.Button(button.Props{Type: button.TypeSubmit, Size: button.SizeSm}) {
						Save review
					}
				</div>
			</form>
		}
		if len(v.Entries) > 0 {
			<ol class="space-y-2 text-sm">
				for _, e := range v.Entries {
					@reviewEntry(e)
				}
			</ol>
		} else {
			@EmptyHint("No reviews yet.")
		}
	</section>
}

// myLatestLabels returns the current reviewer's most recent label set
// on this subject so the form pre-fills with what you saved last
// instead of starting blank. Returns nil when there's no identity
// configured (the form opens empty — same as a fresh reviewer with
// nothing saved yet) or when the current reviewer hasn't reviewed
// this subject before.
//
// Pre-filling matters because the data model writes a full label-set
// snapshot on every save: a blank submission would otherwise wipe
// whatever you saved last, which makes the common "I just want to
// add a comment" workflow a footgun. With the field pre-populated,
// "save as-is" preserves your labels, "edit" modifies them, and
// "clear the box, save" deliberately clears them — same model as a
// regular settings form.
func myLatestLabels(ctx context.Context, entries []ReviewEntryView) []string {
	r := ReviewerFromContext(ctx)
	if r == nil {
		return nil
	}
	// e.Author is the prefixed stamp from the record (`human:slug` /
	// `agent:slug[/model]`); Resolved.String() formats the current
	// reviewer in the same shape via Stringer, so the comparison
	// works whether the saved stamp was a human or an agent.
	me := r.String()
	for _, e := range entries {
		if e.IsLatest && e.Author == me {
			return e.Labels
		}
	}
	return nil
}

// identityRequired stands in for review/outcome forms when the current
// session has no reviewer identity configured. Submitting either
// without an identity bounces through /identity anyway and re-types
// the form on return — better UX is to show up-front that the action
// is gated, with a one-click path to set up. action is the verb-
// phrase the placeholder reads ("leave a review", "record an
// outcome") so the same component covers both call-sites.
templ identityRequired(action string) {
	<div class="rounded-md border border-dashed border-border bg-card px-4 py-5 text-center space-y-2.5">
		<p class="text-[12.5px] text-muted-foreground">Set your reviewer identity to { action }.</p>
		@button.Button(button.Props{Href: identityChangeHref(ctx), Size: button.SizeSm}) {
			Set identity
		}
	</div>
}

templ reviewEntry(e ReviewEntryView) {
	<li class="rounded-md border border-border bg-surface-sunken p-3 space-y-1.5">
		<div class="flex items-baseline justify-between gap-3 text-xs">
			<div class="flex items-baseline gap-2">
				@AuthorStamp(e.Author)
				if e.IsLatest {
					@StatusPill(StatusToneInfo, "latest")
				}
			</div>
			<span class="text-muted-foreground tabular-nums">{ e.At.Format("2006-01-02 15:04 MST") }</span>
		</div>
		if len(e.Labels) > 0 {
			@LabelChips(e.Labels)
		} else {
			@EmptyHint("no labels")
		}
		if strings.TrimSpace(e.Comment) != "" {
			<p class="text-[13.5px] text-foreground whitespace-pre-wrap leading-relaxed">
				@RichText(e.Comment)
			</p>
		}
	</li>
}
